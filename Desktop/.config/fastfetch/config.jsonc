{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/images/pekopeko.jpg",
    "type": "kitty",
    "height": 11,
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "display": {
    "separator": " ›  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "34",
        "at": "34",
        "host": "34"
      }
    },
    "break",
    {
      "type": "os",
      "format": "{2}",
      "key": "󰣇 ",
      "keyColor": "31"
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "31"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "31"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "32",
      "format": "{1}"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "32",
      "format": "{1}"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "32",
      "format": "{1}"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "33",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": " ",
      "keyColor": "33",
      "hideType": "integrated",
      "format": "{vendor} {name}"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "33"
    }
  ]
}
