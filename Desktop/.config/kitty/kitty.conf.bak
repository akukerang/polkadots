font_family      CaskaydiaMono Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size 10.5

window_padding_width 12

cursor_shape block
shell_integration no-cursor

# background_blur 1
# background_opacity 0.9

term xterm-256color

# BEGIN_KITTY_THEME
# Noctalia
include current-theme.conf
# END_KITTY_THEME