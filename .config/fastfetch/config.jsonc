{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/images/pekora.jpg",
    "type": "kitty",
    "height": 8,
    "padding": {
      "top": 1,
      "left": 1
    }
  },
  "display": {
    "separator": " ›  "
  },
  "modules": [
    "break",
    {
      "type": "os",
      "format": "{2}",
      "key": " ",
      "keyColor": "31" // = color1
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "31"
    },
    {
      "type": "packages",
      "format": "{} (dnf)",
      "key": " ",
      "keyColor": "32"
    },
    {
      "type": "uptime",
      "key": " ",
      "keyColor": "32"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "33",
      "format": "{1}"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "33",
      "format": "{1}"
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "34",
      "format": "{1}"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "34"
    },
    "break"
  ]
}
